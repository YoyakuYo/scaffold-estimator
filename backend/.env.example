# Database
# --- Supabase (recommended): use the Connection Pooler URL (port 6543), not direct (5432).
#    In Supabase: Project Settings → Database → Connection string → "URI" → Mode: "Transaction" or "Session".
#    That URL uses port 6543 and avoids "Connection terminated due to connection timeout".
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# --- Render Postgres: if backend runs on Render, set INTERNAL_DATABASE_URL on the Web Service (from Postgres "Info" → Internal URL).
# INTERNAL_DATABASE_URL=postgresql://...
#
# --- Or any Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# Or individual params:
# DB_HOST=
# DB_PORT=5432
# DB_USERNAME=
# DB_PASSWORD=
# DB_NAME=postgres

# JWT (required)
JWT_SECRET=your-secret-min-32-chars
JWT_EXPIRES_IN=3600s

# Supabase (for Supabase client / Auth when used)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (optional, for background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional: AWS S3 (exports)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-1
# AWS_S3_BUCKET=
