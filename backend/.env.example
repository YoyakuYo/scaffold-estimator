# Database: Supabase only (no direct Postgres connection)
# The app uses Supabase project URL + service role key and talks to Postgres via PostgREST (HTTP).
# No DATABASE_URL or connection pooler needed — avoids connection timeouts.
# Get these from Supabase: Project Settings → API → Project URL and service_role key.

# JWT (required)
JWT_SECRET=your-secret-min-32-chars
JWT_EXPIRES_IN=3600s

# Supabase (required for DB access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vision BIM (optional; uses ANTHROPIC_API_KEY)
# ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# Redis (optional, for background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional: AWS S3 (exports)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-1
# AWS_S3_BUCKET=
