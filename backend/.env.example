# Database: Supabase only (no direct Postgres connection)
# The app uses Supabase project URL + service role key and talks to Postgres via PostgREST (HTTP).
# No DATABASE_URL or connection pooler needed — avoids connection timeouts.
# Get these from Supabase: Project Settings → API → Project URL and service_role key.

# JWT (required)
JWT_SECRET=your-secret-min-32-chars
JWT_EXPIRES_IN=3600s

# Supabase (required for DB access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vision BIM (optional; uses ANTHROPIC_API_KEY)
# ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# Redis (optional, for background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Web Push — PWA device notifications (optional; requires supabase-migrations/121_push_subscriptions.sql)
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional: AWS S3 (exports)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-1
# AWS_S3_BUCKET=

# Stripe (optional — billing / Checkout)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# FRONTEND_URL=http://localhost:3001
#
# Recurring (e.g. yearly updates) + optional one-time (license) per tier:
STRIPE_PRICE_ID_BASIC=price_1THoooAspPQFfmijEvPKe4Ch
STRIPE_PRICE_ID_MEDIUM=price_1THooCAspPQFfmijm1OuResL
STRIPE_PRICE_ID_PREMIUM=price_1THonMAspPQFfmijYnbzxwwz
STRIPE_PRICE_ID_BASIC_ONETIME=price_1THmRAAspPQFfmijKJSfbsTS
STRIPE_PRICE_ID_MEDIUM_ONETIME=price_1THnwkAspPQFfmijKB0dNnrN
STRIPE_PRICE_ID_PREMIUM_ONETIME=price_1THnjvAspPQFfmij8qgIVSMl
