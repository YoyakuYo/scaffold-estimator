# Backend API (full base URL including /api/v1). Set on the FRONTEND host (Vercel etc.);
# the browser does not read backend-only env vars.
#
# Local backend (npm run dev on backend :3000):
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api/v1
#
# Deployed API (required for production frontend builds that are not opened on localhost):
# NEXT_PUBLIC_BACKEND_URL=https://your-app.onrender.com/api/v1
#
# Optional: Web Push public key (same as backend VAPID_PUBLIC_KEY). If omitted, the app fetches
# GET /notifications/push/vapid-public-key from the API after login.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BGx...

# If you open the app at http://localhost:* (or 127.0.0.1) and omit NEXT_PUBLIC_BACKEND_URL,
# the client uses http://localhost:3000/api/v1 automatically.

# Optional: show the legacy scaffold "AI Extraction" tab (plan/PDF/IFC full analyze). Default is hidden;
# stepped/setback buildings use the "Stepped massing" tab and its dedicated AI image endpoint instead.
# Uncomment only if you need the old tab:
# NEXT_PUBLIC_SHOW_LEGACY_AI_EXTRACT_TAB=true

# Supabase (for future Supabase Auth / client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: bank transfer block on /billing if the API does not return bankTransfer yet.
# Redeploy the frontend after changing these (values are embedded at build time).
# NEXT_PUBLIC_BANK_TRANSFER_ENABLED=true
# NEXT_PUBLIC_BANK_TRANSFER_BANK_NAME=
# NEXT_PUBLIC_BANK_TRANSFER_BRANCH=
# NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_TYPE=
# NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_NUMBER=
# NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_HOLDER=
# NEXT_PUBLIC_BANK_TRANSFER_AMOUNT_NOTE=
# NEXT_PUBLIC_BANK_TRANSFER_BANK_NAME_EN=
# NEXT_PUBLIC_BANK_TRANSFER_BRANCH_EN=
# NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_TYPE_EN=
# NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_HOLDER_EN=
# NEXT_PUBLIC_BANK_TRANSFER_AMOUNT_NOTE_EN=
# NEXT_PUBLIC_BANK_TRANSFER_BANK_NAME_FR=
# NEXT_PUBLIC_BANK_TRANSFER_BRANCH_FR=
# NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_TYPE_FR=
# NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_HOLDER_FR=
# NEXT_PUBLIC_BANK_TRANSFER_AMOUNT_NOTE_FR=
