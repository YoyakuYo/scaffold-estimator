# Backend API (full base URL including /api/v1)
# Local: NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api/v1
# Production (e.g. Render): set in your frontend host's env and rebuild:
#   NEXT_PUBLIC_BACKEND_URL=https://scaffold-estimator.onrender.com/api/v1

# Supabase (for future Supabase Auth / client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
